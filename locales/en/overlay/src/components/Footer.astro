---
import { withBase } from "../lib/url";

const currentYear = new Date().getFullYear();
---

<footer style="border-top:3px solid var(--rule-strong); background-color:var(--page-bg);">
  <div class="container-page grid gap-9 py-12 sm:grid-cols-3 text-[13px]">
    <div>
      <p class="font-display font-black" style="font-size:17px; color:var(--text);">
        Curation Jleague
      </p>
      <p class="mt-2.5 leading-relaxed" style="color:var(--text-muted);">
        An ad-free news and article curator for all 20 J1 clubs.
      </p>
    </div>
    <div>
      <p class="font-bold mb-2.5" style="color:var(--text);">Site links</p>
      <div class="flex flex-col gap-2" style="color:var(--text-faint);">
        <a class="no-underline" style="color:inherit;" href={withBase("/")}>Home</a>
        <a class="no-underline" style="color:inherit;" href={withBase("/news/")}>All news</a>
        <a class="no-underline" style="color:inherit;" href={withBase("/team/")}>By club</a>
        <a class="no-underline" style="color:inherit;" href={withBase("/topic/")}>Browse topics</a>
        <a class="no-underline" style="color:inherit;" href={withBase("/search/")}>Search news</a>
        <a class="no-underline" style="color:inherit;" href={withBase("/about/")}>About this site</a>
      </div>
    </div>
    <div>
      <p class="font-bold mb-2.5" style="color:var(--text);">Using this site</p>
      <p class="leading-relaxed" style="color:var(--text-muted);">
        Headlines and summaries link to the original publishers. Full articles are not reproduced.
      </p>
    </div>
  </div>
  <div style="border-top:1px solid var(--rule-weak);">
    <div class="container-page flex flex-wrap justify-between gap-2 py-4 text-[12px]" style="color:var(--text-faint);">
      <span>© {currentYear} Curation Jleague — no ads, no tracking.</span>
      <span>Headlines link to their original publishers</span>
    </div>
  </div>
</footer>
