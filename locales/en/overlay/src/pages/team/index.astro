---
import Base from "../../layouts/Base.astro";
import TeamLinkRow from "../../components/TeamLinkRow.astro";
import { teams } from "../../lib/teams";
---

<Base title="News by club" description="Choose from all 20 J1 clubs to read their news.">
  <section class="container-page" style="padding:44px 24px 64px;">
    <h1 class="font-display font-black m-0" style="font-size:28px; color:var(--text); margin-bottom:6px;">News by club</h1>
    <p style="font-size:14px; color:var(--text-muted); margin-bottom:32px;">
      Choose from all 20 J1 clubs to read the latest news.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
      {teams.map((team) => (
        <TeamLinkRow team={team} />
      ))}
    </div>
  </section>
</Base>
